# ============================================================
# 品牌配置示例：复制到「项目根/.env」后按需改
#
# 项目根 = 清单 assemble.json 所在目录。服务端启动时由
# server/config/brand.js 的 readBrand() 读取这份文件；start.sh 不做 source，
# 所以改完重启服务即可生效，不用改任何 shell 脚本。
#
# 取值优先级（高 → 低）：
#   1. 进程环境变量 BRAND_*（部署时 export 即可，不用改文件）
#   2. 项目根 .env 的 BRAND_*（本文件）
#   3. assemble.json 的 brand 段（旧写法，继续可用）
#   4. 内置默认值：title=Downloader / logo=favicon.png / icon=favicon.png
#
# 任一层留空（如 BRAND_LOGO=）等于没配，会继续往下一级取；四个键最终都有值，
# 页面上不会再出现 @brand:xxx@ 占位符。
# ============================================================

# 页面标题：<title> 与 img 的 alt 文案
BRAND_TITLE=Downloader

# 顶栏 logo 文件名，相对 server/public/
BRAND_LOGO=favicon.png

# 浏览器标签页图标（favicon），相对 server/public/
BRAND_ICON=favicon.png

# 顶栏标题文字，允许内联 HTML（换行用 <br>，不会被转义）
# 留空或不写时回退 BRAND_TITLE
# 需要两行标题时可写成：BRAND_DISPLAY_TITLE=My App<br>Downloader
BRAND_DISPLAY_TITLE=Downloader
