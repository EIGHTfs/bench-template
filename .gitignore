node_modules/
*.pid
server/*.log
server/config.json
downloads/
.tmp-build/
.tmp-run/
.trash/

# 生成物（setup.sh 组装，不入库）；blueprint/ 是组装蓝图（入库，白名单）
server/project/*
!server/project/blueprint/

# 模板示例项目：example/ 是**普通项目**，组装与运行方式同任何项目。
#   example/assemble.json      ← 入库（示例清单，演示混搭）
#   example/ASSEMBLE-COVERAGE.md ← 入库（组装覆盖面说明，通用实例）
#   example/server/            ← 组装产物，不入库，可随时删掉重装
#   example/config.json        ← 运行期生成（含密码哈希）**绝不入库**
#   example/sessions.json      ← 运行期生成（会话 token）**绝不入库**
#   example/start.sh           ← 组装产物（由清单下发），不入库
# 注意 config.json / sessions.json 落在【项目根】而非 server/ 下，上面的
# server/config.json 规则是锚定 server/ 的，管不到这里 —— 实测这两个文件
# 会以未跟踪状态暴露出来（含密码哈希与有效会话 token，务必忽略）。
example/server/
example/start.sh
example/config.json
example/sessions.json

# 安全删除回收站 + setup.sh 备份
server/templates/.trash-*/
setup.sh.bak*

# Python 缓存
__pycache__/
*.pyc
node_modules.orig/
